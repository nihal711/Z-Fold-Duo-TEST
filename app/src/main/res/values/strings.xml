<resources>
    <string name="app_name" translatable="false">ZFoldDuo</string>
    <string name="accessibility_name">ZFoldDuo fold animation</string>
    <string name="accessibility_description">Draws a frosted-glass folding animation across the whole screen that follows the real hinge angle. The screen is captured into memory only while an animation is playing and is never saved or sent anywhere.</string>

    <!-- Hinge readout -->
    <string name="angle_placeholder" translatable="false">—°</string>
    <string name="angle_format" translatable="false">%1$.3f°</string>
    <string name="angle_source_private">Samsung internal hinge sensor via ADB</string>
    <string name="angle_source_public">Android hinge sensor (basic mode)</string>
    <string name="angle_source_none">No hinge angle yet</string>
    <string name="rate_format" translatable="false">%1$.1f Hz</string>
    <string name="rate_placeholder" translatable="false">— Hz</string>

    <!-- Setup checklist -->
    <string name="section_link">1 · Wireless debugging link</string>
    <string name="section_overlay">2 · Overlay service</string>
    <string name="section_diagnostics">Diagnostics</string>
    <string name="link_help">Full mode needs a one-time pairing with Wireless debugging. Enable Developer options, turn on Wireless debugging, open “Pair device with pairing code”, then enter the 6-digit code here or from the notification ZFoldDuo posts.</string>
    <string name="link_help_local_network">Android 17 asks for local-network access when the app first starts. It is only used to discover the wireless debugging port on this device.</string>
    <string name="code_hint">6-digit code</string>
    <string name="button_pair">Pair</string>
    <string name="button_open_wireless_debugging">Open Wireless debugging</string>
    <string name="button_open_developer_options">Open Developer options</string>
